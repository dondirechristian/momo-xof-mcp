# Copier en .env et remplir. Ne jamais committer .env.

# Environnement : sandbox | production
# En sandbox, le serveur refuse tout appel vers un endpoint de production.
MOMO_ENV=sandbox

# Agrégateur utilisé en v0.1 : cinetpay | paydunya
MOMO_PROVIDER=cinetpay

# Identifiants fournis par l'agrégateur. NE JAMAIS remplir ici : ce fichier est
# committé. Copier en .env, qui est ignoré par git, et renseigner là-bas.
# Ces deux valeurs sont échangées contre un jeton sur POST /v1/oauth/login,
# où elles s'appellent api_key et api_password (voir docs/API-CINETPAY.md).
# Le mot de passe API se définit sur le tableau de bord, page « API & sécurité » ;
# il vaut « Non configuré » par défaut.
MOMO_API_KEY=
MOMO_API_PASSWORD=

# URL de base de l'API CinetPay, relevée sur le tableau de bord le 2026-09-21.
# Sandbox, version « 1.0 Aurore ».
# L'URL de production n'est PAS connue : tant qu'elle ne l'est pas, ne rien
# écrire ici d'autre que la sandbox. Le serveur refuse de toute façon un
# endpoint de production tant que MOMO_ENV=sandbox.
MOMO_BASE_URL=https://api.cinetpay.net

# URL de rappel et de rebond. CinetPay exige les TROIS, elles ne peuvent pas
# rester vides : notify_url, success_url et failed_url sont obligatoires à
# l'initialisation (voir docs/API-CINETPAY.md). Maximum 120 caractères chacune.
# La v0.1 n'ayant pas de serveur web, ce sont des URL fournies par l'exploitant.
MOMO_CALLBACK_URL=
MOMO_SUCCESS_URL=
MOMO_FAILED_URL=

# Plafond de sécurité, en XOF, appliqué côté serveur.
# Toute demande au-delà est refusée avec un message explicite.
MOMO_MAX_AMOUNT=50000

# Délai réseau en secondes
MOMO_TIMEOUT=30

# --- Réservé à scripts/first_call.py, la sonde manuelle ---
# Identité client exigée par l'API. Valeurs synthétiques par défaut dans le
# script ; ne surcharger que si le compte impose autre chose.
MOMO_TEST_EMAIL=
MOMO_TEST_FIRST_NAME=
MOMO_TEST_LAST_NAME=

# Numéro de test, FACULTATIF. Laissé vide, aucun numéro n'est envoyé — ce qui
# est sans conséquence puisque la sonde tourne en direct_pay: false et ne
# sollicite donc aucun téléphone. Ne jamais mettre ici un numéro personnel.
MOMO_TEST_MSISDN=
