# Copier en .env et remplir. Ne jamais committer .env.

# Environnement : sandbox | production
# En sandbox, le serveur refuse tout appel vers un endpoint de production.
MOMO_ENV=sandbox

# Agrégateur utilisé en v0.1 : cinetpay | paydunya
MOMO_PROVIDER=cinetpay

# Identifiants fournis par l'agrégateur (valeurs sandbox uniquement ici)
MOMO_API_KEY=
MOMO_SITE_ID=
MOMO_API_SECRET=

# URL de base de l'API CinetPay, relevée sur le tableau de bord le 2026-09-21.
# Sandbox, version « 1.0 Aurore ».
# L'URL de production n'est PAS connue : tant qu'elle ne l'est pas, ne rien
# écrire ici d'autre que la sandbox. Le serveur refuse de toute façon un
# endpoint de production tant que MOMO_ENV=sandbox.
MOMO_BASE_URL=https://api.cinetpay.net

# URL de rappel pour les notifications de statut (peut rester vide en v0.1)
MOMO_CALLBACK_URL=

# Plafond de sécurité, en XOF, appliqué côté serveur.
# Toute demande au-delà est refusée avec un message explicite.
MOMO_MAX_AMOUNT=50000

# Délai réseau en secondes
MOMO_TIMEOUT=30
